{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Student or Admin profile information",
      "type": "object",
      "properties": {
        "userID": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 20 },
        "role": { "type": "string", "enum": ["student", "admin"] },
        "education": { "type": "string", "maxLength": 100 },
        "state": { "type": "string", "maxLength": 100 },
        "income": { "type": "string", "maxLength": 50 },
        "category": { "type": "string", "maxLength": 50 },
        "gender": { "type": "string", "maxLength": 20 },
        "disabilityStatus": { "type": "boolean" },
        "minority": { "type": "boolean" },
        "savedScholarships": { "type": "array" },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userID", "name", "email", "role"]
    },
    "Scholarship": {
      "title": "Scholarship",
      "description": "Scholarship listing detail",
      "type": "object",
      "properties": {
        "scholarshipID": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "provider": { "type": "string", "maxLength": 150 },
        "amount": { "type": "number" },
        "amountText": { "type": "string", "maxLength": 100 },
        "deadline": { "type": "string", "maxLength": 50 },
        "eligibility": { "type": "string", "maxLength": 1000 },
        "educationLevel": { "type": "string", "maxLength": 100 },
        "course": { "type": "string", "maxLength": 100 },
        "state": { "type": "string", "maxLength": 100 },
        "incomeLimit": { "type": "number" },
        "category": { "type": "string", "maxLength": 100 },
        "gender": { "type": "string", "maxLength": 20 },
        "officialLink": { "type": "string", "maxLength": 500 },
        "documents": { "type": "array" },
        "featured": { "type": "boolean" },
        "type": { "type": "string", "enum": ["Government", "Private", "International"] },
        "bannerImage": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["scholarshipID", "title", "provider", "amount", "deadline"]
    },
    "Application": {
      "title": "Scholarship Application",
      "description": "Record of student application to a scholarship",
      "type": "object",
      "properties": {
        "applicationID": { "type": "string", "maxLength": 128 },
        "userID": { "type": "string", "maxLength": 128 },
        "scholarshipID": { "type": "string", "maxLength": 128 },
        "scholarshipTitle": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "enum": ["Submitted", "Under Review", "Shortlisted", "Accepted", "Rejected"] },
        "appliedAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["applicationID", "userID", "scholarshipID", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "entities.User" },
      "description": "User profile collection"
    },
    "/scholarships/{scholarshipId}": {
      "schema": { "$ref": "entities.Scholarship" },
      "description": "Scholarships collection"
    },
    "/applications/{applicationId}": {
      "schema": { "$ref": "entities.Application" },
      "description": "Applications collection"
    }
  }
}
